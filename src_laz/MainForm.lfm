object frmMain: TfrmMain
  Left = 300
  Height = 620
  Top = 200
  Width = 790
  Caption = 'Webcam Settings'
  ClientHeight = 620
  ClientWidth = 790
  Font.Color = clWindowText
  Font.Height = -12
  Font.Name = 'Tahoma'
  LCLVersion = '4.6.0.0'
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  object pnlTop: TPanel
    Left = 0
    Height = 65
    Top = 0
    Width = 790
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 65
    ClientWidth = 790
    TabOrder = 0
    object lblCameras: TLabel
      Left = 8
      Height = 14
      Top = 8
      Width = 103
      Caption = 'Available Webcams'
    end
    object cboCameras: TComboBox
      Left = 8
      Height = 22
      Top = 30
      Width = 360
      ItemHeight = 14
      Style = csDropDownList
      TabOrder = 0
      OnChange = cboCamerasChange
    end
    object btnSettings: TButton
      Left = 378
      Height = 26
      Top = 30
      Width = 120
      Caption = 'Settings'
      TabOrder = 1
      OnClick = btnSettingsClick
    end
    object chkShowPreview: TCheckBox
      Left = 512
      Height = 18
      Top = 32
      Width = 135
      Caption = 'Show webcam image'
      Checked = True
      State = cbChecked
      TabOrder = 2
      OnChange = chkShowPreviewChange
    end
  end
  object pnlPreview: TPanel
    Left = 0
    Height = 525
    Top = 65
    Width = 790
    Align = alClient
    BevelOuter = bvNone
    Color = clBlack
    ParentBackground = False
    ParentColor = False
    TabOrder = 1
    OnResize = pnlPreviewResize
  end
  object pnlBottom: TPanel
    Left = 0
    Height = 30
    Top = 590
    Width = 790
    Align = alBottom
    BevelOuter = bvNone
    ClientHeight = 30
    ClientWidth = 790
    TabOrder = 2
    object lblVersion: TLabel
      Left = 8
      Height = 14
      Top = 8
      Width = 77
      Caption = 'Version: 1.0.0'
    end
  end
end
